<?xml version="1.0" encoding="utf-8"?>
<!--
    Nada deste app pode ir para backup. As preferencias guardam hash de PIN,
    contatos e codigo de panico cifrados com uma chave do Keystore que nao sai
    do aparelho: restaurar em outro aparelho so' produziria lixo, e o backup em
    si ja' seria um vazamento de que o app existe e esta' configurado.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
</full-backup-content>
